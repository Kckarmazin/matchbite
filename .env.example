# ==============================================================================
# MatchBite Environment Configuration
# ==============================================================================

# Server Port
PORT=3001
NODE_ENV=development

# ------------------------------------------------------------------------------
# Phase 1 Launch: Zero-Cost Mode (Default)
# ------------------------------------------------------------------------------
# Leave empty for 100% free operation using OpenStreetMap Overpass + Zippopotam.us.
# MatchBite works completely out of the box with zero API keys required.

# ------------------------------------------------------------------------------
# Phase 2 Scale: Commercial Google Places API Adapter (Optional)
# ------------------------------------------------------------------------------
# When your app experiences viral traffic or you want official Google Places photos
# and reviews, simply supply your Google Maps API Key here. The backend automatically
# switches provider with 0 code changes.
# GOOGLE_MAPS_API_KEY=AIzaSy...

# ------------------------------------------------------------------------------
# Phase 3 Scale: Distributed Redis Store & PubSub (Optional)
# ------------------------------------------------------------------------------
# For horizontal multi-instance container scaling across Kubernetes / ECS / Fly.io:
# REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# Affiliate & Monetization Tracking
# ------------------------------------------------------------------------------
# Commission partner tracking IDs for reservations and food delivery
AFFILIATE_OPENTABLE_ID=matchbite
AFFILIATE_DOORDASH_ID=matchbite
AFFILIATE_UBEREATS_ID=matchbite
